[android]
package/name="com.kemanist38.timefragments"
package/unique_name="com.kemanist38.timefragments"
package/signed=true
package/app_category=9
screen/immersive=true
screen/orientation=1
permissions/internet=true
permissions/access_network_state=true

[debug]
settings/fps/force_fps=60

[memory]
limits/message_queue/max_size=8192

[physics]
3d/default_gravity=20.0
common/physics_ticks_per_second=60

[gui]
theme/custom_font="res://assets/fonts/default_font.tres"
